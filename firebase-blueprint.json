{
  "entities": {
    "VisitorSession": {
      "title": "VisitorSession",
      "description": "Student visitor session tracking platform access and active features",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique session identifier generated by the client"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student full name if provided"
        },
        "studentNim": {
          "type": "string",
          "maxLength": 30,
          "description": "Student identification number (NIM) if provided"
        },
        "device": {
          "type": "string",
          "maxLength": 50,
          "description": "Device category (Desktop, Tablet, Mobile)"
        },
        "browser": {
          "type": "string",
          "maxLength": 50,
          "description": "Browser name and version summary"
        },
        "firstSeen": {
          "type": "string",
          "maxLength": 60,
          "description": "ISO timestamp when the session began"
        },
        "lastSeen": {
          "type": "string",
          "maxLength": 60,
          "description": "ISO timestamp of the latest interaction"
        },
        "totalActions": {
          "type": "number",
          "description": "Total count of student actions performed in this session"
        },
        "lastFeature": {
          "type": "string",
          "maxLength": 100,
          "description": "Last visited learning feature"
        },
        "featuresUsed": {
          "type": "array",
          "description": "List of distinct learning feature keys used"
        }
      },
      "required": [
        "sessionId",
        "device",
        "browser",
        "firstSeen",
        "lastSeen",
        "totalActions",
        "lastFeature",
        "featuresUsed"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Auditable log entry for learning operations, query runs, and quiz attempts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique UUID for the log entry"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Associated session ID"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 60,
          "description": "ISO timestamp when the activity occurred"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student full name if provided"
        },
        "studentNim": {
          "type": "string",
          "maxLength": 30,
          "description": "Student identification number if provided"
        },
        "feature": {
          "type": "string",
          "maxLength": 100,
          "description": "Feature where action occurred"
        },
        "action": {
          "type": "string",
          "maxLength": 100,
          "description": "Specific action name"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable summary or payload"
        },
        "device": {
          "type": "string",
          "maxLength": 50,
          "description": "Client device"
        },
        "browser": {
          "type": "string",
          "maxLength": 50,
          "description": "Client browser"
        }
      },
      "required": ["id", "sessionId", "timestamp", "feature", "action", "details"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Student quiz or UAS exam simulation completion record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique result identifier"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Associated session ID"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Student full name"
        },
        "studentNim": {
          "type": "string",
          "maxLength": 30,
          "description": "Student NIM"
        },
        "score": {
          "type": "number",
          "description": "Percentage score (0-100)"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total number of questions answered"
        },
        "passed": {
          "type": "boolean",
          "description": "Whether passing threshold was attained"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 60,
          "description": "ISO timestamp of exam completion"
        },
        "mode": {
          "type": "string",
          "maxLength": 50,
          "description": "Quiz mode (e.g. UAS Simulasi, Latihan Terstruktur)"
        }
      },
      "required": ["id", "sessionId", "score", "totalQuestions", "passed", "timestamp", "mode"]
    }
  },
  "firestore": {
    "/visitor_sessions/{sessionId}": {
      "schema": "VisitorSession",
      "description": "Real-time records of visitors accessing the BasisData platform"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Detailed log of all actions taken across SQL Lab, Normalisasi, and Kuis"
    },
    "/quiz_results/{resultId}": {
      "schema": "QuizResult",
      "description": "Student completion records for quizzes and exam simulations"
    }
  }
}
